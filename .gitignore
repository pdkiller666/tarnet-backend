# Зависимости
node_modules/

# Кэш ONNX-модели PII (109 МБ весов). В git не место: скачивается по запросу,
# а в истории репозитория раздувал бы клон. Путь совпадает с MODEL_CACHE_DIR
# в pii-classifier.js.
.model-cache/
# Не класть кэш в /tmp: на VPS /tmp — это tmpfs (822 МБ = RAM), и установка
# туда дала ENOSPC при 34 ГБ свободного места на /dev/vda1.

# Секреты: мастер-ключ и seed лотереи. Попадание в git = компрометация.
.secrets/

# Базы данных и их WAL/SHM
tarnet.db
# Боевая БД живёт НЕ здесь, а в /var/lib/tarnet/tarnet.db (TARNET_DB в systemd).
# Пустой файл рядом с кодом сбивает с толку: кто-то откроет его и решит, что данных нет.
# 2026-10-24 такой файл (0 байт) удалён с VPS. Путь здесь не указывать: корень
# репозитория — сам backend-api, и строка вида backend-api/tarnet.db не матчит ничего.
tarnet.db-wal
tarnet.db-shm
*.db
*.db-wal
*.db-shm

# Резервные копии
*.bak-*
archive/backups/

# Логи и временные файлы
*.log
/tmp/
.DS_Store

# Архивы БД (batcharchive / lottery / batching-бэкапы)
tarnet.db.*.gz
tarnet.db.*.bak*
*.db.gz
*.db.bak*
*.sqlite
*.sqlite3

# Артефакты приёмки и временные БД
/tmp/tarnet-test-*

# Артефакты Knowledge Loop (Волна 7): выгрузки датасетов.
# В git не место: каждый прогон создаёт новый JSONL с timestamp в имени,
# и репозиторий раздувался бы данными, которые воспроизводятся одной командой.
/storage/
